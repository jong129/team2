DROP TABLE CHAT_DATA_REF CASCADE CONSTRAINTS;

CREATE TABLE CHAT_DATA_REF (
    REF_ID      NUMBER(10)     NOT NULL,
    CHAT_ID     NUMBER(10)     NOT NULL,
    DATA_TYPE   VARCHAR2(50),
    DATA_ID     NUMBER(10),
    CREATED_AT  DATE DEFAULT SYSDATE,

    CONSTRAINT PK_CHAT_DATA_REF PRIMARY KEY (REF_ID),
    CONSTRAINT FK_CHAT_DATA_REF_CHAT
        FOREIGN KEY (CHAT_ID)
        REFERENCES CHAT_HISTORY(CHAT_ID)
);

COMMENT ON TABLE CHAT_DATA_REF IS '채팅 응답에 사용된 참조 데이터 연결 테이블';

COMMENT ON COLUMN CHAT_DATA_REF.REF_ID IS '참조 데이터 PK';
COMMENT ON COLUMN CHAT_DATA_REF.CHAT_ID IS '채팅 FK';
COMMENT ON COLUMN CHAT_DATA_REF.DATA_TYPE IS '참조 데이터 유형(FILE, REAL_ESTATE 등)';
COMMENT ON COLUMN CHAT_DATA_REF.DATA_ID IS '참조 데이터 ID';
COMMENT ON COLUMN CHAT_DATA_REF.CREATED_AT IS '참조 데이터 생성 일시';

DROP SEQUENCE SEQ_CHAT_DATA_REF_ID;

CREATE SEQUENCE SEQ_CHAT_DATA_REF_ID
START WITH 1
INCREMENT BY 1
MAXVALUE 9999999999
CACHE 2
NOCYCLE;
